# SQLite file (default local.db). The Docker image uses /app/db/jrg-tools.db: mount a volume on /app/db.
DATABASE_URL=local.db

# Clerk (https://dashboard.clerk.com → API keys), the same instance as jrg-life. /admin needs a user
# whose private metadata has `role: "admin"` and a `scope` (e.g. "tree,trip,tools") that includes "tools".
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
